@@ -0,0 +1,19 @@
+package com.jd.genie.data.jdbc.catalog.databricks;
+
+import com.jd.genie.data.jdbc.catalog.WarehouseCatalog;
+
+/**
+ * ELT-Bench: Databricks catalog.
+ */
+public class DatabricksCatalog extends WarehouseCatalog {
+
+    @Override
+    protected String listTablesSql() {
+        return "SELECT table_name, comment AS comments, table_type, table_schema FROM information_schema.tables WHERE lower(table_schema) = lower(?) ORDER BY table_name";
+    }
+
+    @Override
+    protected String columnsSql() {
+        return "SELECT column_name, data_type, comment AS comments, ordinal_position AS position, is_nullable AS nullable FROM information_schema.columns WHERE lower(table_schema) = lower(?) AND lower(table_name) = lower(?) ORDER BY ordinal_position";
