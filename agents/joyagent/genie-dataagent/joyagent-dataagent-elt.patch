+package com.jd.genie.data.jdbc.dialect.databricks;
+
+import com.jd.genie.data.jdbc.dialect.DialectEnum;
+import com.jd.genie.data.jdbc.dialect.JdbcDialect;
+import com.jd.genie.data.jdbc.dialect.WarehouseSqlUtils;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+
+/**
+ * ELT-Bench: Databricks dialect.
+ */
+public class DatabricksDialect implements JdbcDialect {
+
+    @Override
+    public DialectEnum dialectName() {
+        return DialectEnum.DATABRICKS;
+    }
+
+    @Override
+    public String driverName() {
+        return "com.databricks.client.jdbc.Driver";
+    }
+
+    @Override
+    public String pagingEnd(int start, int pageSize) {
+        return WarehouseSqlUtils.limitOffset(start, pageSize);
+    }
+
+    @Override
+    public String formatSql(String sql) {
+        // backtick identifiers are native in Databricks SQL
+        return sql;
+    }
+
+    @Override
+    public Statement createStreamStatement(Connection connection, Integer fetchSize) throws SQLException {
+        // the MySQL streaming hint (fetch size Integer.MIN_VALUE) is rejected by this driver
+        Statement statement = connection.createStatement(ResultSet.TYPE_FORWARD_ONLY, ResultSet.CONCUR_READ_ONLY);
+        statement.setFetchSize(DEFAULT_EXPORT_FETCH_SIZE);
+        statement.setMaxRows(EXPORT_MAX_SIZE);
+        statement.setQueryTimeout(QUERY_MAX_TIME);
+        return statement;
+    }
+}
