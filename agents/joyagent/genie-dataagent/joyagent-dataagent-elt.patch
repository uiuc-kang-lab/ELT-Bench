diff --git a/genie-backend/src/main/java/com/jd/genie/data/jdbc/dialect/WarehouseSqlUtils.java b/genie-backend/src/main/java/com/jd/genie/data/jdbc/dialect/WarehouseSqlUtils.java
new file mode 100644
index 0000000..2e96e77
--- /dev/null
+++ b/genie-backend/src/main/java/com/jd/genie/data/jdbc/dialect/WarehouseSqlUtils.java
@@ -0,0 +1,60 @@
+package com.jd.genie.data.jdbc.dialect;
+
+/**
+ * ELT-Bench helpers shared by the Snowflake, Databricks and Redshift dialects.
+ */
+public final class WarehouseSqlUtils {
+
+    private WarehouseSqlUtils() {
+    }
+
+    /**
+     * The NL2SQL prompt quotes every identifier with backticks (MySQL style). Snowflake and Redshift quote identifiers
+     * with double quotes, so backticks outside string literals are replaced by {@code quote}. Identifiers keep their
+     * case. Redshift folds quoted identifiers to lower case by default, so case does not matter there.
+     */
+    public static String replaceBackticks(String sql, char quote) {
+        return replaceBackticks(sql, quote, false);
+    }
+
+    /**
+     * As {@link #replaceBackticks(String, char)}; with {@code upperSimple}, plain identifiers (letters, digits, _ and $)
+     * are upper-cased inside the quotes. That is how Snowflake resolves unquoted identifiers, and Airbyte and dbt
+     * create upper-case names there, while model fields written in lower case (e.g. sync-value fields) would otherwise
+     * not resolve. Other identifiers (aliases with spaces or Chinese text) keep their case.
+     */
+    public static String replaceBackticks(String sql, char quote, boolean upperSimple) {
+        if (sql == null || sql.indexOf('`') < 0) {
+            return sql;
+        }
+        StringBuilder out = new StringBuilder(sql.length());
+        boolean inString = false;
+        for (int i = 0; i < sql.length(); i++) {
+            char c = sql.charAt(i);
+            if (c == '\'' ) {
+                inString = !inString;
+                out.append(c);
+            } else if (c == '`' && !inString) {
+                int end = sql.indexOf('`', i + 1);
+                if (end < 0) {
+                    out.append(quote);
+                    continue;
+                }
+                String name = sql.substring(i + 1, end);
+                if (upperSimple && name.matches("[A-Za-z_][A-Za-z0-9_$]*")) {
+                    name = name.toUpperCase();
+                }
+                out.append(quote).append(name).append(quote);
+                i = end;
+            } else {
+                out.append(c);
+            }
+        }
+        return out.toString();
+    }
+
+    /** LIMIT/OFFSET paging for warehouses that do not accept MySQL's "LIMIT offset,count". */
+    public static String limitOffset(int start, int pageSize) {
+        return " LIMIT " + pageSize + " OFFSET " + (start * pageSize);
+    }
+}
