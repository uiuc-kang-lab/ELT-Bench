+package com.jd.genie.data.jdbc.catalog.redshift;
+
+import com.jd.genie.data.jdbc.catalog.WarehouseCatalog;
+
+/**
+ * ELT-Bench: Redshift catalog.
+ */
+public class RedshiftCatalog extends WarehouseCatalog {
+
+    @Override
+    protected String listTablesSql() {
+        return "SELECT c.relname AS table_name, obj_description(c.oid, 'pg_class') AS comments, CASE c.relkind WHEN 'v' THEN 'VIEW' ELSE 'TABLE' END AS table_type, n.nspname AS table_schema FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r', 'v') AND lower(n.nspname) = lower(?) ORDER BY c.relname";
+    }
+
+    @Override
+    protected String columnsSql() {
+        return "SELECT a.attname AS column_name, format_type(a.atttypid, a.atttypmod) AS data_type, col_description(a.attrelid, a.attnum) AS comments, a.attnum AS position, CASE WHEN a.attnotnull THEN 'NO' ELSE 'YES' END AS nullable FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace WHERE lower(n.nspname) = lower(?) AND lower(c.relname) = lower(?) AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum";
+    }
+}
