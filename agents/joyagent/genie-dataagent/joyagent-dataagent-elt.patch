index 0000000..7bf78a9
--- /dev/null
+++ b/genie-backend/src/main/java/com/jd/genie/data/jdbc/catalog/WarehouseCatalog.java
@@ -0,0 +1,100 @@
+package com.jd.genie.data.jdbc.catalog;
+
+import com.jd.genie.data.SimpleTable;
+import com.jd.genie.data.TableColumn;
+import com.jd.genie.data.exception.CatalogException;
+import com.jd.genie.data.model.StandardColumnType;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+
+/**
+ * ELT-Bench: catalog for Snowflake, Databricks and Redshift. Tables and columns, including column comments, are read
+ * with one SQL query each; subclasses supply the queries. A table may be given as "table" (the task schema is used)
+ * or as "schema.table"; names are matched case-insensitively.
+ */
+public abstract class WarehouseCatalog extends AbstractJdbcCatalog {
+
+    /** Columns, read by position (drivers differ in the case of labels): table_name, comments, table_type, table_schema. Parameters: schema. */
+    protected abstract String listTablesSql();
+
+    /** Columns, read by position: column_name, data_type, comments, position, nullable ('YES'/'NO'). Parameters: schema, table. */
+    protected abstract String columnsSql();
+
+    @Override
+    public List<SimpleTable> listTables(Connection connection, String schema) throws CatalogException {
+        try (PreparedStatement ps = connection.prepareStatement(listTablesSql())) {
+            ps.setString(1, schema);
+            List<SimpleTable> tables = new ArrayList<>();
+            try (ResultSet rs = ps.executeQuery()) {
+                while (rs.next()) {
+                    SimpleTable st = new SimpleTable();
+                    st.setTableName(rs.getString(1));
+                    st.setComments(Objects.toString(rs.getString(2), ""));
+                    st.setTableType(rs.getString(3));
+                    st.setTableSchema(rs.getString(4));
+                    tables.add(st);
+                }
+            }
+            return tables;
+        } catch (Exception e) {
+            throw new CatalogException(String.format("Failed listing tables of schema %s", schema), e);
+        }
+    }
+
+    @Override
+    public List<TableColumn> getTableColumns(Connection connection, String tablePath, String schema) throws CatalogException {
+        String table = tablePath.replace("`", "").replace("\"", "");
+        int dot = table.lastIndexOf('.');
+        if (dot >= 0) {
+            String prefix = table.substring(0, dot);
+            schema = prefix.substring(prefix.lastIndexOf('.') + 1);
+            table = table.substring(dot + 1);
+        }
+        try (PreparedStatement ps = connection.prepareStatement(columnsSql())) {
+            ps.setString(1, schema);
+            ps.setString(2, table);
+            List<TableColumn> columnList = new ArrayList<>();
+            try (ResultSet rs = ps.executeQuery()) {
+                while (rs.next()) {
+                    String originType = String.valueOf(rs.getString(2)).toUpperCase(Locale.ROOT);
+                    columnList.add(TableColumn.builder()
+                            .name(rs.getString(1))
+                            // "" when there is no comment, as MySQL's information_schema returns (the comment is the column's business name)
+                            .comment(Objects.toString(rs.getString(3), ""))
+                            .dataType(standardType(originType))
+                            .originDataType(originType)
+                            .position(rs.getInt(4))
+                            .nullable(!"NO".equalsIgnoreCase(rs.getString(5)))
+                            .build());
+                }
+            }
+            if (columnList.isEmpty()) {
+                throw new CatalogException(String.format("Table %s not found in schema %s", table, schema));
+            }
+            return columnList;
+        } catch (CatalogException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new CatalogException(String.format("Failed getting table %s", tablePath), e);
+        }
+    }
+
+    /** Maps a warehouse type name to the three types the data agent distinguishes. */
+    public static String standardType(String type) {
+        if (type.startsWith("DATE") || type.startsWith("TIME")) {
+            return StandardColumnType.DATE.name();
+        }
+        if (type.startsWith("NUMBER") || type.startsWith("DECIMAL") || type.startsWith("NUMERIC")
+                || type.contains("INT") || type.startsWith("FLOAT") || type.startsWith("DOUBLE")
+                || type.startsWith("REAL") || type.startsWith("BIGINT")) {
+            return StandardColumnType.DECIMAL.name();
+        }
+        return StandardColumnType.VARCHAR.name();
+    }
+}
