+package com.jd.genie.agent.tool.common;
+
+import com.alibaba.fastjson.JSON;
+import com.jd.genie.agent.agent.AgentContext;
+import com.jd.genie.agent.tool.BaseTool;
+import com.jd.genie.agent.util.SpringContextHolder;
+import com.jd.genie.config.data.DataAgentModelConfig;
+import com.jd.genie.service.ChatModelInfoService;
+import lombok.Data;
+import lombok.extern.slf4j.Slf4j;
+
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * ELT-Bench: exposes the data agent's model registration (its data-governance step, normally the model-list
+ * configuration read at start-up) as a tool, because the tables of an ELT task only exist after the agent loads them.
+ * The fields are those of the original model configuration; nothing is filled in on the agent's behalf except a
+ * generated id when none is given.
+ */
+@Slf4j
+@Data
+public class RegisterModelsTool implements BaseTool {
+    /** Returned by nl2sql_query and data_analysis when no model is registered (upstream always has configured models). */
+    public static final String NO_MODELS = "No data models are registered with the data agent. "
+            + "Register the tables you want to query with register_models first.";
+
+    private AgentContext agentContext;
+
+    /** Whether the data agent has at least one registered model. */
+    public static boolean hasModels() {
+        return SpringContextHolder.getApplicationContext().getBean(ChatModelInfoService.class).count() > 0;
+    }
+
+    @Override
+    public String getName() {
+        return "register_models";
+    }
+
+    @Override
+    public String getDescription() {
+        return "Register warehouse tables or SQL queries as data models of the data agent (its data-governance step). "
+                + "nl2sql_query can only use registered models. Each model has the fields of the data agent's model "
+                + "configuration. Registering a model with an existing id replaces it. Column descriptions are read from "
+                + "the warehouse's column comments (COMMENT ON COLUMN), column types and example values from the data. "
+                + "Returns, per model, its id, status, columns or error.";
+    }
+
+    @Override
+    public Map<String, Object> toParams() {
+        Map<String, Object> model = new LinkedHashMap<>();
+        model.put("content", prop("Schema-qualified table name (type table) or a SELECT statement (type sql)."));
+        model.put("type", Map.of("type", "string", "enum", List.of("table", "sql"), "description", "Model type, default table."));
+        model.put("id", prop("Model code used in generated SQL. Generated when omitted."));
+        model.put("name", prop("Business name of the model."));
+        model.put("remark", prop("How the model should be used (passed to NL2SQL as the table's usage rules)."));
+        model.put("businessPrompt", prop("Business rules of the model (passed to NL2SQL)."));
+        model.put("ignoreFields", prop("Comma-separated columns to leave out of the model."));
+        model.put("defaultRecallFields", prop("Comma-separated columns always given to NL2SQL."));
+        model.put("analyzeSuggestFields", prop("Comma-separated columns suggested for analysis."));
+        model.put("analyzeForbidFields", prop("Comma-separated columns that must not be analysed."));
+        model.put("syncValueFields", prop("Comma-separated columns whose values are indexed for value recall."));
+        model.put("columnAliasMap", prop("JSON object mapping a column to comma-separated aliases."));
+        Map<String, Object> item = new HashMap<>();
+        item.put("type", "object");
+        item.put("properties", model);
+        item.put("required", List.of("content"));
+        Map<String, Object> models = new HashMap<>();
+        models.put("type", "array");
+        models.put("items", item);
+        models.put("description", "Models to register.");
+        Map<String, Object> parameters = new HashMap<>();
+        parameters.put("type", "object");
+        parameters.put("properties", Map.of("models", models));
+        parameters.put("required", List.of("models"));
+        return parameters;
+    }
+
+    private static Map<String, Object> prop(String description) {
+        Map<String, Object> p = new HashMap<>();
+        p.put("type", "string");
+        p.put("description", description);
+        return p;
+    }
+
+    @Override
+    public Object execute(Object input) {
+        try {
+            Map<String, Object> params = (Map<String, Object>) input;
+            List<DataAgentModelConfig> configs = JSON.parseArray(JSON.toJSONString(params.get("models")), DataAgentModelConfig.class);
+            ChatModelInfoService service = SpringContextHolder.getApplicationContext().getBean(ChatModelInfoService.class);
+            return JSON.toJSONString(service.registerModels(configs));
+        } catch (Exception e) {
+            log.error("{} register_models error", agentContext == null ? "" : agentContext.getRequestId(), e);
+            return "register_models failed: " + e.getMessage();
+        }
+    }
+}
