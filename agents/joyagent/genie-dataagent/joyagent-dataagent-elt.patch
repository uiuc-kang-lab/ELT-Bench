+++ b/genie-backend/src/main/java/com/jd/genie/agent/tool/common/Nl2SqlQueryTool.java
@@ -0,0 +1,91 @@
+package com.jd.genie.agent.tool.common;
+
+import com.alibaba.fastjson.JSON;
+import com.jd.genie.agent.agent.AgentContext;
+import com.jd.genie.agent.tool.BaseTool;
+import com.jd.genie.agent.util.SpringContextHolder;
+import com.jd.genie.data.dto.ChatQueryData;
+import com.jd.genie.model.req.DataAgentChatReq;
+import com.jd.genie.service.DataAgentService;
+import lombok.Data;
+import lombok.extern.slf4j.Slf4j;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * ELT-Bench: exposes the data agent's NL2SQL query (/data/apiChatQuery, otherwise only used by the web UI and the
+ * analysis sub-agent) as a tool, so the agent can obtain SQL. The question goes through the unchanged pipeline
+ * (rewrite, think, split into sub-questions, one SQL each, execution); the result keeps the original fields. Only the
+ * returned rows are cut to the first ROWS_RETURNED so that the result fits in the model's context.
+ */
+@Slf4j
+@Data
+public class Nl2SqlQueryTool implements BaseTool {
+    private static final int ROWS_RETURNED = 20;
+    private AgentContext agentContext;
+
+    @Override
+    public String getName() {
+        return "nl2sql_query";
+    }
+
+    @Override
+    public String getDescription() {
+        return "Ask the data agent a question about the registered data models (see register_models). It rewrites the "
+                + "question, may split it into sub-questions, generates one SQL query per sub-question in the warehouse's "
+                + "dialect and runs it. Returns, per sub-question, the SQL, the number of rows returned and the first "
+                + ROWS_RETURNED + " rows, or the error.";
+    }
+
+    @Override
+    public Map<String, Object> toParams() {
+        Map<String, Object> question = new HashMap<>();
+        question.put("type", "string");
+        question.put("description", "The question, in natural language.");
+        Map<String, Object> parameters = new HashMap<>();
+        parameters.put("type", "object");
+        parameters.put("properties", Map.of("question", question));
+        parameters.put("required", List.of("question"));
+        return parameters;
+    }
+
+    @Override
+    public Object execute(Object input) {
+        try {
+            if (!RegisterModelsTool.hasModels()) {
+                return RegisterModelsTool.NO_MODELS;
+            }
+            Map<String, Object> params = (Map<String, Object>) input;
+            DataAgentChatReq req = new DataAgentChatReq();
+            req.setContent(String.valueOf(params.get("question")));
+            req.setTraceId(agentContext == null ? null : agentContext.getRequestId());
+            DataAgentService service = SpringContextHolder.getApplicationContext().getBean(DataAgentService.class);
+            List<ChatQueryData> results = service.apiChatQueryDataOrThrow(req);
+            List<Map<String, Object>> out = new ArrayList<>();
+            for (ChatQueryData data : results) {
+                Map<String, Object> r = new LinkedHashMap<>();
+                r.put("question", data.getQuestion());
+                r.put("sql", data.getNl2sqlResult());
+                List<Map<String, Object>> rows = data.getDataList() == null ? List.of() : data.getDataList();
+                r.put("rows_returned", rows.size());
+                r.put("rows", rows.subList(0, Math.min(ROWS_RETURNED, rows.size())));
+                if (data.getErrorMessage() != null) {
+                    r.put("error", data.getErrorMessage());
+                }
+                out.add(r);
+            }
+            return JSON.toJSONString(out);
+        } catch (Exception e) {
+            log.error("{} nl2sql_query error", agentContext == null ? "" : agentContext.getRequestId(), e);
+            Throwable root = e;
+            while (root.getCause() != null && root.getCause() != root) {
+                root = root.getCause();
+            }
+            return "nl2sql_query failed: " + root.getMessage();
+        }
+    }
+}
