{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elt-bench:autonomous-recovery:flat8:single-trajectory:20261028",
  "title": "ELT-Bench single-trajectory recovery annotation: eight peer categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "coverage", "episodes", "excluded_observations", "dbt_usage_inventory_status", "dbt_usage", "workflow_notes", "audit_notes"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectory_id", "task", "agent", "warehouse", "run_id", "source_path", "source_sha256"],
      "properties": {
        "trajectory_id": {"type": "string", "minLength": 1},
        "task": {"$ref": "#/$defs/nullableString"},
        "agent": {"$ref": "#/$defs/nullableString"},
        "warehouse": {"$ref": "#/$defs/nullableString"},
        "run_id": {"$ref": "#/$defs/nullableString"},
        "source_path": {"$ref": "#/$defs/nullableString"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "extraction_loading", "transformation", "turn_mapping_method", "limitations"],
      "properties": {
        "review_status": {"enum": ["complete", "partial", "unreadable"]},
        "extraction_loading": {"$ref": "#/$defs/stageCoverage"},
        "transformation": {"$ref": "#/$defs/stageCoverage"},
        "turn_mapping_method": {"enum": ["provided_index", "openhands_response_id", "claude_feedback_boundary", "unavailable"]},
        "limitations": {"$ref": "#/$defs/stringArray"}
      }
    },
    "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}},
    "excluded_observations": {"type": "array", "items": {"$ref": "#/$defs/excludedObservation"}},
    "dbt_usage_inventory_status": {"enum": ["complete", "partial", "unavailable"]},
    "dbt_usage": {"type": "array", "items": {"$ref": "#/$defs/dbtInvocation"}},
    "workflow_notes": {"$ref": "#/$defs/stringArray"},
    "audit_notes": {"$ref": "#/$defs/stringArray"}
  },
  "allOf": [
    {
      "if": {"properties": {"coverage": {"properties": {"review_status": {"const": "unreadable"}}}}},
      "then": {"properties": {"episodes": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableIndex": {"type": ["integer", "null"], "minimum": 0},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "callArray": {
      "type": "array",
      "items": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]},
      "uniqueItems": true
    },
    "stageCoverage": {"enum": ["reviewed_complete", "partial", "not_reached", "unknown"]},
    "pointer": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "source_path": {"$ref": "#/$defs/nullableString"},
            "tool_seq": {"$ref": "#/$defs/nullableIndex"},
            "call_id": {"$ref": "#/$defs/nullableString"},
            "trajectory_entry": {"$ref": "#/$defs/nullableIndex"},
            "response_entry": {"$ref": "#/$defs/nullableIndex"},
            "decision_turn": {"$ref": "#/$defs/nullableIndex"},
            "json_pointer": {"$ref": "#/$defs/nullableString"},
            "locator": {"$ref": "#/$defs/nullableString"}
          }
        },
        {"type": "null"}
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "pointer", "redacted_excerpt", "explanation"],
      "properties": {
        "role": {"enum": ["failure", "repair", "verification", "context"]},
        "pointer": {"$ref": "#/$defs/pointer"},
        "redacted_excerpt": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "category", "subtype", "stage", "goal", "success_criterion", "failure_calls", "repair_calls", "verification_calls", "first_failure_tool_seq", "failure_decision_turn", "recovery_tool_seq", "recovery_decision_turn", "repair_turns", "outcome", "recovery_method", "feedback_recovery_eligible", "parent_episode_id", "related_episode_ids", "shared_evidence_reason", "secondary_failures", "cause_attribution", "evidence", "notes"],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "category": {"enum": ["airbyte_config_deploy", "sync_control_execution", "dbt_setup_usage", "warehouse_connection", "model_sql", "data_correctness", "delivery_contract", "sql_exploration_validation"]},
        "subtype": {"$ref": "#/$defs/nullableString"},
        "stage": {"enum": ["extraction_loading", "transformation", "cross_stage", "unknown"]},
        "goal": {"type": "string", "minLength": 1},
        "success_criterion": {"type": "string", "minLength": 1},
        "failure_calls": {"$ref": "#/$defs/callArray"},
        "repair_calls": {"$ref": "#/$defs/callArray"},
        "verification_calls": {"$ref": "#/$defs/callArray"},
        "first_failure_tool_seq": {"$ref": "#/$defs/nullableIndex"},
        "failure_decision_turn": {"$ref": "#/$defs/nullableIndex"},
        "recovery_tool_seq": {"$ref": "#/$defs/nullableIndex"},
        "recovery_decision_turn": {"$ref": "#/$defs/nullableIndex"},
        "repair_turns": {"$ref": "#/$defs/nullableIndex"},
        "outcome": {"enum": ["recovered", "unverified", "unrecovered", "abandoned"]},
        "recovery_method": {"enum": ["same_path_correction", "alternative_path", "retry_without_change", "mixed", null]},
        "feedback_recovery_eligible": {"const": true},
        "parent_episode_id": {"$ref": "#/$defs/nullableString"},
        "related_episode_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "shared_evidence_reason": {"$ref": "#/$defs/nullableString"},
        "secondary_failures": {"$ref": "#/$defs/stringArray"},
        "cause_attribution": {"enum": ["agent_action", "external_service_dependency", "mixed", "unknown"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"},
          "minItems": 1,
          "contains": {"properties": {"role": {"const": "failure"}}, "required": ["role"]}
        },
        "notes": {"$ref": "#/$defs/stringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "recovered"}}},
          "then": {
            "properties": {
              "recovery_method": {"enum": ["same_path_correction", "alternative_path", "retry_without_change", "mixed"]},
              "evidence": {"contains": {"properties": {"role": {"const": "verification"}}, "required": ["role"]}}
            }
          },
          "else": {
            "properties": {
              "recovery_tool_seq": {"type": "null"},
              "recovery_decision_turn": {"type": "null"},
              "repair_turns": {"type": "null"},
              "recovery_method": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"properties": {"failure_decision_turn": {"type": "null"}}},
              {"properties": {"recovery_decision_turn": {"type": "null"}}}
            ]
          },
          "then": {"properties": {"repair_turns": {"type": "null"}}}
        }
      ]
    },
    "excludedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "description", "reason"],
      "properties": {
        "pointer": {"$ref": "#/$defs/pointer"},
        "description": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "dbtInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "tool_seq", "decision_turn", "invocation_index", "subcommand", "purpose", "execution_status", "result", "evidence"],
      "properties": {
        "invocation_id": {"type": "string", "minLength": 1},
        "tool_seq": {"$ref": "#/$defs/nullableIndex"},
        "decision_turn": {"$ref": "#/$defs/nullableIndex"},
        "invocation_index": {"type": "integer", "minimum": 0},
        "subcommand": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "execution_status": {"enum": ["issued_confirmed", "issued_unconfirmed", "not_executed", "information_only"]},
        "result": {"enum": ["success", "failure", "unknown"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1}
      }
    }
  }
}
